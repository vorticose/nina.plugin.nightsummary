#!/usr/bin/env bash
# Pre-commit guard: block committing machine-specific infra or secrets to this
# public repo. The real observatory host/user/keys belong in ~/.claude
# (uncommitted). See CLAUDE.md "Security: keep infrastructure and secrets out
# of this repo".
#
# Enable once per clone:
#   git config core.hooksPath scripts/git-hooks
#
# Bypass a confirmed false positive with:
#   git commit --no-verify
set -uo pipefail

# Patterns are base64-safe (require dots/dashes/prefixes) so they don't
# false-positive on the base64 image blobs in .preview/*.html.
patterns=(
  'RBFocus'
  'taile2b1e6'
  'remotetelescope'
  '100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'ghp_[0-9A-Za-z]{36}'
  '(discord(app)?\.com|hooks\.slack\.com)/api/webhooks/[0-9]{15,}'
)

fail=0
for p in "${patterns[@]}"; do
  # --cached scans staged content only, before it becomes a commit.
  if git grep --cached -nIE -e "$p" -- . ':!.github/workflows/secret-scan.yml' ':!scripts/git-hooks/pre-commit'; then
    echo "BLOCKED: staged content matches a forbidden pattern: $p"
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit blocked. Keep machine-specific infra and secrets in ~/.claude, not the repo."
  echo "False positive? Bypass with: git commit --no-verify"
  exit 1
fi
exit 0
