<ResourceDictionary
    x:Class="NINA.Plugin.NightSummary.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Night Summary_Options">
        <StackPanel Orientation="Vertical" Margin="10">

            <Expander Header="Night Summary Settings" IsExpanded="False">
                <StackPanel Margin="10,8,0,8">

                    <TextBlock Text="Report Content" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBlock Text="Detail Level" Width="200" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <ComboBox SelectedIndex="{Binding ReportDetailLevel}" MinWidth="160" VerticalAlignment="Top">
                            <ComboBoxItem>Snapshot</ComboBoxItem>
                            <ComboBoxItem>Standard</ComboBoxItem>
                            <ComboBoxItem>Full</ComboBoxItem>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,2,0,0" MaxWidth="400">
                            <Run FontWeight="Bold">Snapshot</Run><Run> — Header, stat boxes, and filter table only.</Run>
                            <LineBreak />
                            <Run FontWeight="Bold">Standard</Run><Run> — Adds timeline, altitude charts, image quality, per-target image quality, and Target Scheduler bars.</Run>
                            <LineBreak />
                            <Run FontWeight="Bold">Full</Run><Run> — Adds metric chart, session history, and tonight's preview.</Run>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Show Sky Thumbnails" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowSkyThumbnails}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Altitude Charts + Moon Curve on one row; whole row disabled at Snapshot -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Altitude Charts" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowAltitudeChart}" VerticalAlignment="Center" />
                        <!-- Moon Curve sub-group: additionally disabled when altitude chart is off -->
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAltitudeChart}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Show Moon Curve" Width="140" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowMoonCurve}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAltitudeChart}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTsInstalled}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Show Min Altitude" Width="140" VerticalAlignment="Center" />
                            <CheckBox IsChecked="{Binding ShowMinAltitude}" VerticalAlignment="Center" />
                            <TextBlock Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Uses the minimum altitude set in your Target Scheduler project settings"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTsInstalled}" Value="False">
                                                <Setter Property="Text" Value="Target Scheduler not installed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- TS Progress Bars: disabled at Snapshot or if TS not installed -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTsInstalled}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Target Scheduler Progress" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowTSProgressBars}" VerticalAlignment="Center" />
                        <TextBlock Text="Target Scheduler not installed" Foreground="#CC4444" FontSize="11" FontStyle="Italic" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTsInstalled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Star Count CV: disabled at Snapshot -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Star Count CV" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowStarCountCV}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Filter Classifications: disabled at Snapshot or when Star Count CV is off -->
                    <StackPanel Margin="200,4,0,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowStarCountCV}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Expander Header="Filter Classifications" IsExpanded="False">
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="↻" Command="{Binding RefreshFiltersCommand}" Width="24" Height="22"
                                            ToolTip="Reload filters from NINA profile" FontSize="11" Padding="0" />
                                    <TextBlock Text="Filters are read from your NINA profile. Auto uses first-letter matching (L,R,G,B = broadband; H,S,O = narrowband)."
                                               TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="8,0,0,0" MaxWidth="380" VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding FilterItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" Width="120" VerticalAlignment="Center" />
                                                <ComboBox SelectedIndex="{Binding ClassificationIndex}" MinWidth="120">
                                                    <ComboBoxItem>Auto</ComboBoxItem>
                                                    <ComboBoxItem>Broadband</ComboBoxItem>
                                                    <ComboBoxItem>Narrowband</ComboBoxItem>
                                                    <ComboBoxItem>Exclude</ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Show message when no filters found -->
                                <TextBlock Text="No filters found in the active NINA profile." Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilterItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Per-Target IQ: disabled at Snapshot -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Per-Target Image Quality" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowPerTargetIQ}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Expand Sections by Default" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ExpandSectionsDefault}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Session History: disabled at Snapshot and Standard -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="1">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Session History" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowSessionHistory}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Metric Chart: disabled at Snapshot and Standard -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="1">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Metric Chart" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowHFRGraph}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Chart metric selectors: disabled at Snapshot/Standard or when Metric Chart is off -->
                    <StackPanel Margin="200,2,0,2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="1">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowHFRGraph}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Primary Metric" Width="130" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{Binding ChartPrimaryMetric}" MinWidth="160">
                                <ComboBoxItem>HFR</ComboBoxItem>
                                <ComboBoxItem>FWHM</ComboBoxItem>
                                <ComboBoxItem>Guiding RMS</ComboBoxItem>
                                <ComboBoxItem>Focuser Temp (°C)</ComboBoxItem>
                                <ComboBoxItem>Ambient Temp (°C)</ComboBoxItem>
                                <ComboBoxItem>Eccentricity</ComboBoxItem>
                                <ComboBoxItem>Altitude (°)</ComboBoxItem>
                                <ComboBoxItem>Airmass</ComboBoxItem>
                                <ComboBoxItem>Humidity (%)</ComboBoxItem>
                                <ComboBoxItem>Focuser Position (steps)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Secondary Metric" Width="130" VerticalAlignment="Top" Margin="0,4,0,0" />
                            <ComboBox SelectedIndex="{Binding ChartSecondaryMetric}" MinWidth="160" VerticalAlignment="Top">
                                <ComboBoxItem>None</ComboBoxItem>
                                <ComboBoxItem>HFR</ComboBoxItem>
                                <ComboBoxItem>FWHM</ComboBoxItem>
                                <ComboBoxItem>Guiding RMS</ComboBoxItem>
                                <ComboBoxItem>Focuser Temp (°C)</ComboBoxItem>
                                <ComboBoxItem>Ambient Temp (°C)</ComboBoxItem>
                                <ComboBoxItem>Eccentricity</ComboBoxItem>
                                <ComboBoxItem>Altitude (°)</ComboBoxItem>
                                <ComboBoxItem>Airmass</ComboBoxItem>
                                <ComboBoxItem>Humidity (%)</ComboBoxItem>
                                <ComboBoxItem>Focuser Position (steps)</ComboBoxItem>
                            </ComboBox>
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,2,0,0" MaxWidth="320">
                                FWHM and Eccentricity require the Hocus Focus plugin. Focuser Temp requires a focuser with a built-in temperature sensor.
                                Ambient Temp and Humidity require a device connected as a NINA weather data source (e.g. Pegasus UPB, AAG CloudWatcher).
                                Focuser Position requires a motorized focuser.
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Next Night Preview: disabled at Snapshot and Standard, or if TS not installed -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReportDetailLevel}" Value="1">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTsInstalled}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Show Tonight's Preview" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding ShowNextNightPreview}" VerticalAlignment="Center" />
                        <TextBlock Text="Target Scheduler not installed" Foreground="#CC4444" FontSize="11" FontStyle="Italic" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTsInstalled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Width="200" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="400">
                            Requires the Target Scheduler API to be enabled. In Target Scheduler, go to Target Management → select your active profile from the dropdown → click the gear icon → API Preferences → enable API.
                            Note: enabling this will increase report generation time as Target Scheduler computes the full night plan.
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Width="200" />
                        <Button Content="Preview Report" Command="{Binding PreviewReportCommand}" Width="180" />
                        <TextBlock Text="Opens a preview window to test your report settings" Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Margin="0,20,0,10" />

                    <TextBlock Text="Resend Previous Session" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Width="200" />
                        <TextBlock Text="Select any previous session and resend its report through all currently enabled notification channels."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="400" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Width="200" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding AvailableSessions}"
                                  SelectedItem="{Binding SelectedSession}"
                                  DisplayMemberPath="DisplayLabel"
                                  MinWidth="300" />
                        <Button Content="↻" Command="{Binding RefreshSessionsCommand}" Width="30" Margin="6,0,0,0"
                                ToolTip="Reset to 30 most recent sessions" />
                    </StackPanel>

                    <StackPanel Margin="200,4,0,4">
                        <Expander Header="Search older sessions" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="From" Width="40" VerticalAlignment="Center" />
                                    <DatePicker SelectedDate="{Binding SearchFrom}" Width="130" />
                                    <TextBlock Text="To" Width="28" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <DatePicker SelectedDate="{Binding SearchTo}" Width="130" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <Button Content="Search" Command="{Binding SearchSessionsCommand}" Width="80" />
                                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Width="60" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding SearchResultText}" VerticalAlignment="Center"
                                               Foreground="Gray" FontSize="11" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Width="200" />
                        <Button Content="Send Report" Command="{Binding ResendSessionCommand}" Width="180" />
                        <TextBlock Text="{Binding ResendStatus.Text}"
                                   Foreground="{Binding ResendStatus.Foreground}"
                                   Visibility="{Binding ResendStatus.Visibility}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <Separator Margin="0,20,0,10" />

                    <TextBlock Text="Saved Reports" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Save Report Locally" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding SaveReportLocally}" VerticalAlignment="Center" />
                        <TextBlock Text="Saves the HTML report after each session."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0" MaxWidth="350" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Save Path" Width="200" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SaveReportPath, UpdateSourceTrigger=LostFocus}" Width="300" VerticalAlignment="Center" />
                        <Button Content="Browse..." Click="BrowseSaveReportPath_Click" Margin="5,0,0,0" Padding="8,2" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                        <TextBlock Width="200" />
                        <TextBlock Text="Leave blank to use the default: Documents\N.I.N.A.\Night Summary\Saved Reports\"
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="350" />
                    </StackPanel>

                    <Separator Margin="0,20,0,10" />

                    <TextBlock Text="Email Report Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Enable Email Reports" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding EmailEnabled}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Provider selection -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                        <TextBlock Text="Email Provider" Width="200" VerticalAlignment="Center" />
                        <RadioButton Content="Gmail" IsChecked="{Binding UseGmailSmtp}"
                                     GroupName="EmailProvider" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <RadioButton Content="Other provider" IsChecked="{Binding UseCustomSmtp}"
                                     GroupName="EmailProvider" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Gmail section -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseGmailSmtp}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Gmail Address" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding SenderAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="App Password" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Recipient Email Address" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding RecipientAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                            <TextBlock Width="200" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="420">
                                Requires a Gmail App Password — not your regular password.
                                Generate one at myaccount.google.com → Security → App Passwords.
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Other provider section -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseGmailSmtp}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Sender Email" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding SenderAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="App Password / API Key" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Recipient Email Address" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding RecipientAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="SMTP Server" Width="200" VerticalAlignment="Center" />
                            <TextBox MinWidth="300" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Port" Width="200" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Use TLS/SSL" VerticalAlignment="Center" Margin="20,0,8,0" />
                            <CheckBox IsChecked="{Binding SmtpSsl}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <TextBlock Width="200" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="420">
                                <Run FontWeight="Bold">Do not use your regular account password.</Run>
                                <Run>Most providers require an App Password or API key for SMTP access.</Run>
                                <LineBreak /><LineBreak />
                                <Run FontWeight="Bold">Common provider settings:</Run>
                                <LineBreak />
                                <Run>• Outlook.com — smtp-mail.outlook.com : 587, TLS on. App password: myaccount.microsoft.com → Security → App passwords</Run>
                                <LineBreak />
                                <Run>• Yahoo — smtp.mail.yahoo.com : 587, TLS on. App password: myaccount.yahoo.com → Security → Generate app password</Run>
                                <LineBreak />
                                <Run>• iCloud — smtp.mail.me.com : 587, TLS on. App password: appleid.apple.com → Sign-In &amp; Security → App-Specific Passwords</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                        <TextBlock Width="200" />
                        <Button Content="Send Test Email" Command="{Binding TestEmailCommand}" Width="180" />
                        <TextBlock Text="{Binding EmailTestStatus.Text}"
                                   Foreground="{Binding EmailTestStatus.Foreground}"
                                   Visibility="{Binding EmailTestStatus.Visibility}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="If you don't receive the email, check your spam folder."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0" MaxWidth="250" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Margin="0,20,0,10" />

                    <TextBlock Text="Pushover Notifications" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Enable Pushover" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding PushoverEnabled}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="App Token" Width="200" VerticalAlignment="Center" />
                        <TextBox MinWidth="300" Text="{Binding PushoverAppToken, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="User Key" Width="200" VerticalAlignment="Center" />
                        <TextBox MinWidth="300" Text="{Binding PushoverUserKey, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <TextBlock Width="200" />
                        <Button Content="Send Test Notification" Command="{Binding TestPushoverCommand}" Width="180" />
                        <TextBlock Text="{Binding PushoverTestStatus.Text}"
                                   Foreground="{Binding PushoverTestStatus.Foreground}"
                                   Visibility="{Binding PushoverTestStatus.Visibility}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="Create a Pushover application at pushover.net to get your App Token. Your User Key is on your Pushover dashboard."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0" MaxWidth="300" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Margin="0,20,0,10" />

                    <TextBlock Text="Discord Notifications" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Enable Discord" Width="200" VerticalAlignment="Center" />
                        <CheckBox IsChecked="{Binding DiscordEnabled}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Webhook URL" Width="200" VerticalAlignment="Center" />
                        <TextBox MinWidth="300" Text="{Binding DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <TextBlock Width="200" />
                        <Button Content="Send Test Message" Command="{Binding TestDiscordCommand}" Width="180" />
                        <TextBlock Text="{Binding DiscordTestStatus.Text}"
                                   Foreground="{Binding DiscordTestStatus.Foreground}"
                                   Visibility="{Binding DiscordTestStatus.Visibility}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="In Discord, go to channel Settings → Integrations → Webhooks → New Webhook to get your URL."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="20,0,0,0" MaxWidth="300" VerticalAlignment="Center" />
                    </StackPanel>

                    <Separator Margin="0,20,0,10" />

                    <TextBlock Text="Test Report" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Width="200" />
                        <TextBlock Text="Sends a full report using the session data in the test database. To use this, place a nightsummary.sqlite file in the 'test' subfolder of the Night Summary plugin data directory. Uses all currently enabled notification channels."
                                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="400" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <TextBlock Width="200" />
                        <Button Content="Send Test Report" Command="{Binding SendTestReportCommand}" Width="180" />
                        <TextBlock Text="{Binding TestReportStatus.Text}"
                                   Foreground="{Binding TestReportStatus.Foreground}"
                                   Visibility="{Binding TestReportStatus.Visibility}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                </StackPanel>
            </Expander>

        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
