<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>NINA.Plugin.NightSummary</AssemblyName>
    <RootNamespace>NINA.Plugin.NightSummary</RootNamespace>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ApplicationIcon>NINAPluginTemplate.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Major.Minor.Patch set here; build number auto-computed from git commit count -->
    <VersionPrefix>3.3.1</VersionPrefix>
  </PropertyGroup>

  <!-- Auto-compute build number from git commit count and generate version file -->
  <Target Name="SetGitBuildNumber" BeforeTargets="BeforeBuild">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <BuildNumber>$(GitCommitCount)</BuildNumber>
      <FullVersion>$(VersionPrefix).0</FullVersion>
    </PropertyGroup>
    <Message Importance="high" Text="NightSummary: Building version $(FullVersion)" />
    <WriteLinesToFile
      File="$(IntermediateOutputPath)AssemblyVersion.g.cs"
      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;$(FullVersion)&quot;)]&#10;[assembly: System.Reflection.AssemblyFileVersion(&quot;$(FullVersion)&quot;)]"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AssemblyVersion.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="NINA.Plugin" Version="3.3.0.1017-nightly" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MyPluginProperties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="MyPluginDockables\" />
  </ItemGroup>

  <ItemGroup>
    <!-- plugin-icon.png stays embedded in the plugin assembly because ReportGenerator embeds it
         into HTML reports. The dashboard classlib also embeds its own copy for the favicon
         endpoint (separate assembly, separate resource lookup). -->
    <EmbeddedResource Include="..\assets\plugin-icon.png">
      <LogicalName>plugin-icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NINA.Plugin.NightSummary.Dashboard\NINA.Plugin.NightSummary.Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\demo-nightsummary.sqlite">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MyPluginProperties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="MyPluginProperties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!--
    NINA's plugin SDK assumes everything transitive is already loaded by the
    host (System.*, NINA.Core, ASCOM, Accord, etc.) and therefore does NOT copy
    package DLLs into bin/ — keeping the plugin folder small and avoiding
    duplicate-assembly conflicts. The Dashboard project picked up
    Microsoft.Data.Sqlite (SQLite reads on Windows + macOS) which NINA does
    NOT bundle, so the assembly fails to resolve at runtime and every dashboard
    SQLite query throws FileNotFoundException.

    Surgically copy just the M.D.Sqlite assemblies + the win-x64 native SQLite
    binary into bin/ alongside the plugin DLL. The native shim must live under
    runtimes/win-x64/native/ relative to the loaded assembly so the SQLitePCLRaw
    loader finds it (matches its NuGet layout convention).
  -->
  <Target Name="CopyMicrosoftDataSqlite" AfterTargets="Build">
    <ItemGroup>
      <_SqliteRuntime Include="$(NuGetPackageRoot)microsoft.data.sqlite.core\**\lib\net8.0\Microsoft.Data.Sqlite.dll" />
      <_SqliteRuntime Include="$(NuGetPackageRoot)sqlitepclraw.core\**\lib\netstandard2.0\SQLitePCLRaw.core.dll" />
      <_SqliteRuntime Include="$(NuGetPackageRoot)sqlitepclraw.provider.e_sqlite3\**\lib\netstandard2.0\SQLitePCLRaw.provider.e_sqlite3.dll" />
      <_SqliteRuntime Include="$(NuGetPackageRoot)sqlitepclraw.bundle_e_sqlite3\**\lib\netstandard2.0\SQLitePCLRaw.batteries_v2.dll" />
      <_SqliteNative  Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\**\runtimes\win-x64\native\e_sqlite3.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SqliteRuntime)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SqliteNative)"
          DestinationFolder="$(OutDir)runtimes\win-x64\native"
          SkipUnchangedFiles="true" />
  </Target>

</Project>