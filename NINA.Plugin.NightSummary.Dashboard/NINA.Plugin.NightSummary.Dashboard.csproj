<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NINA.Plugin.NightSummary.Dashboard</AssemblyName>
    <RootNamespace>NINA.Plugin.NightSummary.Dashboard</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform SQLite stack. System.Data.SQLite ships natives only for
         Windows + Linux; the companion needs to open the DB on macOS too.
         Microsoft.Data.Sqlite pulls SQLitePCLRaw.bundle_e_sqlite3 which bundles
         native binaries for win-x64/arm64, linux-*, osx-x64, osx-arm64. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Cross-platform JPEG decode/encode for companion's livestack-master
         rescale (2000px master → 760px report embed). Ships RID-specific
         natives for win-x64/arm64, linux-x64/arm64, osx-x64/arm64 — the
         same shape as Microsoft.Data.Sqlite. Plugin side uses WPF's
         JpegBitmapEncoder; it never loads this assembly. -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <!-- Base SkiaSharp ships win + macOS natives but NOT Linux. Without this the
         linux-x64/arm64 publish has no libSkiaSharp.so and the companion throws
         DllNotFoundException when it rescales a livestack master. RID-scoped, so
         it contributes nothing to win/mac builds. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test assembly needs to call internal helpers like ChartGenerator.GetXAxisLabel
         and ReportGenerator.FormatRA. Matches the same grant in plugin AssemblyInfo. -->
    <InternalsVisibleTo Include="NINA.Plugin.NightSummary.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\dashboard.html">
      <LogicalName>dashboard.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\flatpickr.min.css">
      <LogicalName>flatpickr.min.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\flatpickr.min.js">
      <LogicalName>flatpickr.min.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\dashboard.css">
      <LogicalName>dashboard.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\dashboard.js">
      <LogicalName>dashboard.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\setup.html">
      <LogicalName>setup.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\setup.css">
      <LogicalName>setup.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\setup.js">
      <LogicalName>setup.js</LogicalName>
    </EmbeddedResource>
    <!-- assets/plugin-icon.png (the 776x776 brand master) is deliberately NOT embedded.
         Nothing reads it: there is no HTTP icon endpoint and no favicon link, and the
         only former consumer was the dashboard header, which now uses report-icon.png.
         Embedding it cost ~600 KB in a DLL that ships with the plugin and all three
         companion builds. The file itself still lives on disk for the store listing,
         the docs site and gen-companion-icons.py. ReportIconTests asserts it stays
         un-embedded. -->
    <!-- 144x144 palette copy (~9 KB). Both the HTML report header and the dashboard
         header inline this as a base64 data URI and render it at 48px. Inlining the
         full-size art instead made the icon ~90% of every report and put ~800 KB of
         base64 in every dashboard page load.
         Regenerate with scripts/gen-report-icon.py if the brand art changes. -->
    <EmbeddedResource Include="..\assets\report-icon.png">
      <LogicalName>report-icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
