<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NINA.Plugin.NightSummary.Dashboard</AssemblyName>
    <RootNamespace>NINA.Plugin.NightSummary.Dashboard</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\dashboard.html">
      <LogicalName>dashboard.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\dashboard.css">
      <LogicalName>dashboard.css</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Web\dashboard.js">
      <LogicalName>dashboard.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\plugin-icon.png">
      <LogicalName>plugin-icon.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
