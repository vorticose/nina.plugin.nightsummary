<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>NINA.Plugin.NightSummary.DevHost</RootNamespace>
    <AssemblyName>nightsummary-dev-dashboard</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Same lockstep as the companion: header /api/health reads this assembly's
         informational version, which the SDK derives from VersionPrefix. Keep a
         single bump site (the plugin csproj). -->
    <VersionPrefix>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\NINA.Plugin.NightSummary\NINA.Plugin.NightSummary.csproj')), '&lt;VersionPrefix&gt;([^&lt;]+)&lt;').Groups[1].Value)</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NINA.Plugin.NightSummary.Dashboard\NINA.Plugin.NightSummary.Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev harness inherits Microsoft.Data.Sqlite transitively via Dashboard,
         but DevTsReader / etc. open SQLite directly via that same package. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
</Project>
